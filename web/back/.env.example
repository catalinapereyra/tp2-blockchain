# En local, el docker-compose expone PostgreSQL en el puerto 5433.
# En producción (Railway), DATABASE_URL la provee el servicio de PostgreSQL.
DATABASE_URL="postgresql://medichain:medichain@localhost:5433/medichain?schema=public"
JWT_SECRET="cambiame-en-produccion"
# Origen permitido por CORS. Acepta varios separados por coma (ej: dominio de prod
# de Vercel + previews).
FRONT_URL="http://localhost:5173"
PORT=3001

# RPC y direcciones de los contratos, para validar autorización on-chain antes de
# devolver documentos, verificar firmas EIP-712 del flujo sin gas, y validar roles
# contra UserRegistry (ver src/blockchain).
RPC_URL="https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY"
CHAIN_ID=11155111
DOCUMENT_REGISTRY_ADDRESS=""
PERMISSION_MANAGER_ADDRESS=""
USER_REGISTRY_ADDRESS=""
